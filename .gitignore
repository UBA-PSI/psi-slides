.claude/*
# the authoring skill is part of the published documentation, so it is tracked
!.claude/skills/
.DS_Store
node_modules/

# assembled GitHub Pages site (node docs/site/build-site.js _site)
_site/

# generated build output – rebuild with: node build.js <source.md>
# staged clips: copies of source video, regenerated by the build
lectures/*/videos/

docs/site/example/*.html

# shoot.mjs writes a PNG and encodes it to WebP; --keep-png leaves the PNG
docs/site/img/*.png

# the artifact's figure lecture is compiled by docs/artifact/refresh-figures.mjs,
# which splices the emitted SVG into the page – the built views are scratch
docs/artifact/figure-rules/print.html
docs/artifact/figure-rules/audience.html
docs/artifact/figure-rules/print-notes.html
docs/artifact/figure-rules/speaker.html
docs/artifact/figure-rules/.runtime-probe.mjs

lectures/*/print.html
lectures/*/print-notes.html
lectures/*/audience.html
lectures/*/speaker.html
# three lectures ship their built outputs so they can be browsed directly
# from the repo without running build.js: the self-referential tutorial, the
# diagram reference, which is the only place every ::: draw construct is
# drawn rather than described, and the decoration reference, which is the
# only place the cover, divider, card, backdrop and overlay constructions are
# shown rather than described. All three are checked for staleness on release.
!lectures/tutorial/print.html
!lectures/tutorial/print-notes.html
!lectures/tutorial/audience.html
!lectures/tutorial/speaker.html
!lectures/diagrams/print.html
!lectures/diagrams/print-notes.html
!lectures/diagrams/audience.html
!lectures/diagrams/speaker.html
!lectures/decoration/print.html
!lectures/decoration/print-notes.html
!lectures/decoration/audience.html
!lectures/decoration/speaker.html

# scratch scripts a screenshot or coverage run leaves behind
.psi-*.mjs
.beats-tmp.mjs

# playwright smoke-test scratch
.playwright-mcp/
